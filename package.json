{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of extensions for pi, the coding agent.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extensions"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "extensions/*/index.ts"
    ],
    "themes": [
      "themes/*.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.0",
    "@earendil-works/pi-coding-agent": "^0.99.0",
    "@earendil-works/pi-tui": "^0.99.0",
    "@types/node": "^22.10.2",
    "typebox": "^1.3.27",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "cost": "node extensions/cost-tracker/cli.ts",
    "themes": "node themes/generate.ts",
    "themes:check": "node themes/generate.ts --check"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ignore": "^7.0.12",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.1"
  }
}
